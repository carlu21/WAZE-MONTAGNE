PORT=8787
JWT_SECRET=change-me-in-production
DATABASE_PATH=./data/mountain-live.db
UPLOAD_DIR=./uploads
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173
# Adresses IP des reverse-proxies de confiance (X-Forwarded-For honoré uniquement derrière eux), ex. 127.0.0.1
TRUST_PROXY=
# En production, JWT_SECRET est obligatoire (32 caractères minimum) : l'API refuse de démarrer sinon.
# Géocodeur en ligne de repli (IGN Géoplateforme). GEOCODER_DISABLED=1 pour le couper.
GEOCODER_URL=https://data.geopf.fr/geocodage/search
GEOCODER_DISABLED=0
